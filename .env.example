# ─── Fixify Environment Variables ────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to Git.
#
# Prefix rules:
#   NEXT_PUBLIC_*  — safe to expose to the browser
#   (no prefix)    — server-only, never in the browser

# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Service-role key — server-only, never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# ─── App URL ──────────────────────────────────────────────────────────────────
# Used for deep-links inside notification messages.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Currency & Localization ──────────────────────────────────────────────────
NEXT_PUBLIC_CURRENCY_CODE=INR
NEXT_PUBLIC_CURRENCY_SYMBOL=₹
NEXT_PUBLIC_CURRENCY_LOCALE=en-IN

# ─── Payment Provider ─────────────────────────────────────────────────────────
# Razorpay credentials (live payments)
RAZORPAY_KEY_ID=<your-razorpay-key-id>
RAZORPAY_KEY_SECRET=<your-razorpay-key-secret>
RAZORPAY_WEBHOOK_SECRET=<your-razorpay-webhook-secret>

# Mock Payments (Development/Staging Only)
# Set to 'true' to use MockProvider instead of Razorpay in non-production environments.
# MockProvider is automatically disabled in production — attempting to enable it will throw an error.
# Use this for testing payment flows without processing real transactions.
MOCK_PAYMENTS=false
# Set to 'true' to simulate payment verification failures in MockProvider.
# Only affects MockProvider; ignored when using live Razorpay.
MOCK_PAYMENT_FAIL=false

# ─── Razorpay WhatsApp Business API (Phase 10 — Notifications) ───────────────
# Obtain from the Razorpay dashboard → WhatsApp Business.
# Register and get Meta template approval before using in production.
# Server-only — never expose these to the browser.
RAZORPAY_WHATSAPP_API_KEY=<your-razorpay-whatsapp-api-key>
RAZORPAY_WHATSAPP_PHONE_ID=<your-whatsapp-phone-number-id>
RAZORPAY_WHATSAPP_BUSINESS_ACCOUNT_ID=<your-waba-id>

# ─── SMS via AWS SNS (Phase 10 — Notifications) ───────────────────────────────
# IAM user must have sns:Publish permission.
# Sender ID must be registered with TRAI DLT before use in India.
# Server-only.
AWS_ACCESS_KEY_ID=<your-aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<your-aws-secret-access-key>
AWS_SNS_REGION=ap-south-1
# 6-char alpha DLT-registered sender ID. Default: FIXIFY
SMS_SENDER_ID=FIXIFY

# ─── Email via SendGrid (Phase 10 — Notifications) ───────────────────────────
# API key must have "Mail Send" scope.
# The FROM address must be a verified sender in your SendGrid account.
# Server-only.
SENDGRID_API_KEY=<your-sendgrid-api-key>
EMAIL_FROM=noreply@fixify.in
